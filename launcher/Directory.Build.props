<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The product version of both exes; CMakeLists.txt reads it for the game's VERSIONINFO. -->
    <Version>1.6.1</Version>
    <Product>WWE All Stars Recomp</Product>
    <Copyright>WWE All Stars Recomp contributors. BSD-3-Clause.</Copyright>
    <!-- Build output stays in the repo's ignored out/ folder. -->
    <BaseOutputPath>$(MSBuildThisFileDirectory)../out/launcher/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../out/launcher/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
