+// WSAWaitForMultipleEvents return values.
+inline constexpr uint32_t kWsaWaitIoCompletion = 0xC0;
+inline constexpr uint32_t kWsaWaitTimeout = 0x102;
+inline constexpr uint32_t kWsaWaitFailed = 0xFFFFFFFF;
+inline constexpr uint32_t kWsaInfinite = 0xFFFFFFFF;
+
+// The NT wait behind a WSAWaitForMultipleEvents call.
+struct EventWait {
+  uint32_t nt_wait_type;                // KWAIT_TYPE: 0 WaitAll, 1 WaitAny
+  std::optional<int64_t> timeout_ticks;  // 100 ns units, negative = relative; none = infinite
+  // The host may add its wake event after the title's events (a blocking wait for any).
+  bool wakeable;
+};
+
+// fWaitAll FALSE waits for any event. The millisecond timeout becomes a relative NT
+// timeout (a positive one would be read as an absolute time).
+inline EventWait PlanEventWait(uint32_t wait_all, uint32_t timeout_ms) {
+  EventWait wait{wait_all ? 0u : 1u, std::nullopt, !wait_all && timeout_ms != 0};
+  if (timeout_ms != kWsaInfinite) {
+    wait.timeout_ticks = -int64_t(timeout_ms) * 10000;
+  }
+  return wait;
+}
+
+// The NT wait status as WSAWaitForMultipleEvents returns it: the signalled (or abandoned)
+// event's index, WSA_WAIT_IO_COMPLETION, WSA_WAIT_TIMEOUT, or WSA_WAIT_FAILED. With
+// `wake_slot`, index `count` is the host's wake event, which the title sees as a timeout.
+inline uint32_t EventWaitResult(uint32_t nt_status, uint32_t count, bool wake_slot = false) {
+  if (wake_slot && (nt_status == count || nt_status == 0x80 + count)) {
+    return kWsaWaitTimeout;
+  }
+  if (nt_status < count || (nt_status >= 0x80 && nt_status < 0x80 + count)) {
+    return nt_status;
+  }
+  if (nt_status == kWsaWaitIoCompletion || nt_status == kWsaWaitTimeout) {
+    return nt_status;
+  }
+  return kWsaWaitFailed;
+}
