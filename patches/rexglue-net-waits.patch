+  // A datagram landed on `socket`: tries its pending receives. Each one that completes
+  // leaves the table and goes to `complete(overlapped, bytes)` under the lock, so a guest
+  // poll after this finds it finished. Returns how many completed.
+  template <typename Receive, typename Complete>
+  int Arrived(uint32_t socket, Receive&& receive, Complete&& complete) {
+    std::lock_guard lock(mutex_);
+    int completed = 0;
+    for (auto it = pending_.begin(); it != pending_.end();) {
+      if (it->second.socket == socket) {
+        const int received = receive(it->second);
+        if (received >= 0) {
+          complete(it->first, received);
+          it = pending_.erase(it);
+          ++completed;
+          continue;
+        }
+      }
+      ++it;
+    }
+    return completed;
+  }
+
+  // The guest sockets with a pending receive, ascending.
+  std::vector<uint32_t> Sockets() const {
+    std::lock_guard lock(mutex_);
+    std::vector<uint32_t> sockets;
+    for (const auto& entry : pending_) {
+      sockets.push_back(entry.second.socket);
+    }
+    std::sort(sockets.begin(), sockets.end());
+    sockets.erase(std::unique(sockets.begin(), sockets.end()), sockets.end());
+    return sockets;
+  }
