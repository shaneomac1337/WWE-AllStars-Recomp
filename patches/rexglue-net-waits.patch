new file mode 100644
index 0000000..2ba6528
--- /dev/null
+++ b/include/rex/kernel/xam/net_wake.h
@@ -0,0 +1,24 @@
+/**
+ * @file        net_wake.h
+ * @brief       Ends a title thread's blocking WSAWaitForMultipleEvents wait early.
+ *
+ * Every blocking wait-any WSAWaitForMultipleEvents (fWaitAll FALSE, timeout not 0) also
+ * waits on one host event, the wake slot, placed after the title's events. Signalling it
+ * ends such a wait, and the title sees WSA_WAIT_TIMEOUT, as if its timeout had run out.
+ *
+ * Net-Z's Transport Thread, this title's only such waiter, sends what the game queued once
+ * per pass, and a pass starts when a receive event fires or the 10 ms wait times out. A
+ * title hook calls this right after it queues something urgent (a SyncSim step's input),
+ * so the pass, and the send, runs now instead of up to 10 ms later.
+ */
+
+#pragma once
+
+namespace rex::kernel::xam {
+
+// Signals the shared wake slot. The slot is one auto-reset event, so a call ends one
+// wait: the current blocking wait-any of whichever title thread is in one, or else the
+// next one to start. Safe from any thread; does nothing before the title's first such wait.
+void EndBlockingEventWait();
+
+}  // namespace rex::kernel::xam
diff --git a/include/rex/system/arrival_watcher.h b/include/rex/system/arrival_watcher.h
new file mode 100644
index 0000000..a6345fd
--- /dev/null
+++ b/include/rex/system/arrival_watcher.h
@@ -0,0 +1,211 @@
+/**
+ * @file        arrival_watcher.h
+ * @brief       Reports datagrams landing on host sockets that have pending guest receives.
+ *
+ * A guest overlapped WSARecvFrom that finds nothing stays pending. Real hardware completes
+ * it and sets its OVERLAPPED's event when a datagram arrives, and a title such as Net-Z's
+ * Transport Thread sleeps in WSAWaitForMultipleEvents until then. This watcher gives the
+ * host the same: one thread blocks in select() on the watched sockets and hands each one a
+ * datagram lands on to a callback, which completes the receive. Wake() makes it reread the
+ * watched set (a receive was posted on a socket it is not watching yet).
+ *
+ * In an include list that needs windows.h first, include this after <winsock2.h>.
+ */
+
+#pragma once
+
+#include <rex/platform.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <functional>
+#include <thread>
+#include <utility>
+#include <vector>
+
+#if REX_PLATFORM_WIN32
+#include <winsock2.h>
+#else
+#include <arpa/inet.h>
+#include <fcntl.h>
+#include <netinet/in.h>
+#include <sys/select.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#endif
+
+namespace rex::system::net {
+
+struct ArrivalWatcherOptions {
+  // false: run as if the wake socket could not be opened (tests).
+  bool open_wake_socket = true;
+  // Told once when the watcher runs without its wake socket.
+  std::function<void(const char*)> warn;
+};
+
+// The watched-set snapshot is taken without holding the guest's sockets: one may be
+// closed, and its native handle even reused by a new socket, before select() runs. Both
+// are harmless. A closed handle fails select(), and the next pass rereads the set. A
+// reused one can only report the old guest id, whose receives closesocket has forgotten,
+// so nothing is taken and the next pass rereads the set. Passes that take nothing back
+// off (kBackoffMin..kBackoffMax) so neither case can spin.
+class ArrivalWatcher {
+ public:
+  // A host socket to watch and the id the callback gets for it (the guest socket handle).
+  struct Watch {
+    uint64_t native;
+    uint32_t id;
+  };
+  // Without the wake socket, Wake() can't end a wait, so waits are this short instead.
+  static constexpr std::chrono::milliseconds kNoWakePoll{10};
+  // With it, the timeout only bounds how long a missed Wake() could go unnoticed.
+  static constexpr std::chrono::milliseconds kWakePoll{250};
+  static constexpr std::chrono::milliseconds kBackoffMin{1};
+  static constexpr std::chrono::milliseconds kBackoffMax{10};
+
+  // `watched` lists the sockets to watch; it is asked again before every wait. `arrived`
+  // gets the id of a socket a datagram landed on and returns whether it took one.
+  ArrivalWatcher(std::function<std::vector<Watch>()> watched,
+                 std::function<bool(uint32_t)> arrived, ArrivalWatcherOptions options = {})
+      : watched_(std::move(watched)), arrived_(std::move(arrived)) {
+    if (!options.open_wake_socket || !OpenWake()) {
+      Close(wake_);
+      wake_ = kNone;
+      if (options.warn) {
+        options.warn("arrival watcher: no wake socket; polling every 10 ms");
+      }
+    }
+    thread_ = std::thread([this] { Run(); });
+  }
+
+  ~ArrivalWatcher() {
+    stop_ = true;
+    Wake();
+    thread_.join();
+    Close(wake_);
+  }
+
+  ArrivalWatcher(const ArrivalWatcher&) = delete;
+  ArrivalWatcher& operator=(const ArrivalWatcher&) = delete;
+
+  void Wake() {
+    if (wake_ != kNone) {
+      const char byte = 0;
+      send(wake_, &byte, 1, 0);
+    }
+  }
+
+ private:
+#if REX_PLATFORM_WIN32
+  using Native = SOCKET;
+  static constexpr Native kNone = INVALID_SOCKET;
+  static void Close(Native s) {
+    if (s != kNone) closesocket(s);
+  }
+  // FD_SETSIZE caps how many sockets an fd_set holds.
+  static bool Fits(Native, size_t count) { return count < FD_SETSIZE; }
+#else
+  using Native = int;
+  static constexpr Native kNone = -1;
+  static void Close(Native s) {
+    if (s != kNone) close(s);
+  }
+  // FD_SETSIZE caps the descriptor's value; FD_SET past it writes out of bounds.
+  static bool Fits(Native s, size_t) { return s >= 0 && s < FD_SETSIZE; }
+#endif
+
+  // A UDP socket on loopback, connected to itself: a byte sent to it wakes select().
+  bool OpenWake() {
+    wake_ = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if (wake_ == kNone || !Fits(wake_, 0)) {
+      return false;
+    }
+    sockaddr_in name{};
+    name.sin_family = AF_INET;
+    name.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+#if REX_PLATFORM_WIN32
+    int len = sizeof(name);
+#else
+    socklen_t len = sizeof(name);
+#endif
+    if (bind(wake_, reinterpret_cast<sockaddr*>(&name), sizeof(name)) != 0 ||
+        getsockname(wake_, reinterpret_cast<sockaddr*>(&name), &len) != 0 ||
+        connect(wake_, reinterpret_cast<sockaddr*>(&name), sizeof(name)) != 0) {
+      return false;
+    }
+#if REX_PLATFORM_WIN32
+    u_long non_blocking = 1;
+    return ioctlsocket(wake_, FIONBIO, &non_blocking) == 0;
+#else
+    const int flags = fcntl(wake_, F_GETFL);
+    return flags >= 0 && fcntl(wake_, F_SETFL, flags | O_NONBLOCK) == 0;
+#endif
+  }
+
+  void DrainWake() {
+    char data[64];
+    while (recv(wake_, data, sizeof(data), 0) > 0) {
+    }
+  }
+
+  void Run() {
+    const auto poll = wake_ != kNone ? kWakePoll : kNoWakePoll;
+    auto backoff = kBackoffMin;
+    while (!stop_) {
+      const auto watched = watched_();
+      fd_set readable;
+      FD_ZERO(&readable);
+      Native highest = 0;
+      size_t count = 0;
+      if (wake_ != kNone) {
+        FD_SET(wake_, &readable);
+        highest = wake_;
+        ++count;
+      }
+      for (const auto& w : watched) {
+        const auto native = static_cast<Native>(w.native);
+        if (!Fits(native, count)) {
+          continue;  // not watched this pass; its receive completes on the guest's poll
+        }
+        FD_SET(native, &readable);
+        highest = native > highest ? native : highest;
+        ++count;
+      }
+      if (count == 0) {
+        // select() with no sockets fails on Windows; wait the poll out instead.
+        std::this_thread::sleep_for(poll);
+        continue;
+      }
+      timeval limit{0, long(std::chrono::microseconds(poll).count())};
+      const int ready = select(int(highest + 1), &readable, nullptr, nullptr, &limit);
+      bool idle = ready < 0;  // a socket closed under us
+      if (ready > 0) {
+        if (wake_ != kNone && FD_ISSET(wake_, &readable)) {
+          DrainWake();
+        }
+        for (const auto& w : watched) {
+          const auto native = static_cast<Native>(w.native);
+          if (Fits(native, 0) && FD_ISSET(native, &readable) && !arrived_(w.id)) {
+            idle = true;  // readable but nothing taken (an error the receive skipped)
+          }
+        }
+      }
+      if (idle) {
+        std::this_thread::sleep_for(backoff);
+        backoff = std::min(backoff * 2, kBackoffMax);
+      } else {
+        backoff = kBackoffMin;
+      }
+    }
+  }
+
+  std::function<std::vector<Watch>()> watched_;
+  std::function<bool(uint32_t)> arrived_;
+  Native wake_ = kNone;
+  std::atomic<bool> stop_{false};
+  std::thread thread_;
+};
+
+}  // namespace rex::system::net
