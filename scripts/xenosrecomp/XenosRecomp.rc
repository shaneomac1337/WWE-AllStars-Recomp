// The shader converter's version information. CMake links this through build-xenosrecomp.ps1, so the shared source
// tree in .tools/xenosrecomp stays as the patch leaves it.
#define VS_FFI_FILEFLAGSMASK 0x3FL
#define VOS_NT_WINDOWS32 0x00040004L
#define VFT_APP 0x00000001L

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "WWE All Stars Recomp contributors"
      VALUE "LegalCopyright", "MIT licensed, see licenses in the release"
      VALUE "FileDescription", "Xbox 360 shader converter for WWE All Stars Recomp"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "XenosRecomp"
      VALUE "OriginalFilename", "XenosRecomp.exe"
      VALUE "ProductName", "WWE All Stars Recomp"
      VALUE "ProductVersion", "1.0.0.0"
      VALUE "Comments", "Based on the MIT-licensed re:Blue XenosRecomp fork"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
